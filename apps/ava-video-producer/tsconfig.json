{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ES2023.Intl"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@utils": ["../../packages/shared/utils/src/index.ts"],
      "@utils/*": ["../../packages/shared/utils/src/*"]
    }
  },
  "include": ["src"]
}
