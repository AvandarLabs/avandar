{
  "name": "@avandar/ava-video-producer",
  "version": "0.1.0",
  "private": true,
  "description": "Avandar workspace video producer, component previews, Motion Atlas, and sample films",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "studio": "node scripts/require-license.mjs && remotion studio",
    "adopt": "node scripts/require-license.mjs && node scripts/adopt-theme.mjs",
    "preview": "node scripts/require-license.mjs && sh scripts/preview.sh demo",
    "render": "node scripts/require-license.mjs && sh scripts/render.sh demo",
    "check": "node scripts/require-license.mjs && node scripts/check-frames.mjs out/demo.mp4",
    "showcase": "node scripts/require-license.mjs && tsx scripts/showcase/server.ts",
    "typecheck": "node scripts/require-license.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "node scripts/require-license.mjs && tsx --test tests/*.test.ts scripts/showcase/**/*.test.ts showcase/*.test.mjs",
    "video": "node scripts/require-license.mjs && tsx scripts/video.ts",
    "capture": "node scripts/require-license.mjs && node scripts/capture-avandar/capture-avandar.mjs",
    "data:generate": "node scripts/require-license.mjs && python3 demo-data/generate.py",
    "data:validate": "node scripts/require-license.mjs && python3 demo-data/validate.py",
    "render:showcase": "node scripts/require-license.mjs && sh scripts/render-showcase.sh",
    "preview:showcase": "node scripts/require-license.mjs && PREVIEW_ONLY=1 sh scripts/render-showcase.sh",
    "studio:licensed": "node scripts/require-license.mjs && bash scripts/studio.sh",
    "capture:curate": "node scripts/require-license.mjs && node scripts/curate-capture.mjs",
    "component:build": "node scripts/require-license.mjs && node scripts/build-avandar.mjs",
    "component:review": "node scripts/require-license.mjs && node scripts/review-avandar.mjs",
    "motion:build": "node scripts/require-license.mjs && node scripts/build-motion-gallery.mjs",
    "motion": "node scripts/require-license.mjs && tsx scripts/motion.ts",
    "component:measure": "node scripts/require-license.mjs && node scripts/measure-avandar.mjs",
    "component:deliver": "node scripts/require-license.mjs && node scripts/deliver-avandar.mjs",
    "video:new": "node scripts/require-license.mjs && node scripts/new-video.mjs",
    "component:watch": "node scripts/require-license.mjs && node scripts/build-avandar.mjs --watch",
    "pretest": "node scripts/require-license.mjs && node scripts/build-avandar.mjs",
    "pretypecheck": "node scripts/require-license.mjs && node scripts/build-motion-gallery.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@dnd-kit/helpers": "0.1.18",
    "@dnd-kit/react": "0.1.18",
    "@fontsource-variable/figtree": "^5.2.8",
    "@lingui/core": "^6.2.0",
    "@lingui/message-utils": "6.2.0",
    "@lingui/react": "^6.2.0",
    "@mantine/charts": "^9.2.0",
    "@mantine/core": "catalog:",
    "@mantine/dates": "9.2.0",
    "@mantine/dropzone": "^9.2.0",
    "@mantine/form": "catalog:",
    "@mantine/hooks": "catalog:",
    "@mantine/modals": "catalog:",
    "@mantine/notifications": "catalog:",
    "@mantine/tiptap": "^9.2.0",
    "@puckeditor/core": "^0.21.1",
    "@radix-ui/react-popover": "1.1.15",
    "@react-querybuilder/core": "8.20.2",
    "@react-querybuilder/mantine": "^8.16.1",
    "@remotion/bundler": "4.0.516",
    "@remotion/cli": "4.0.516",
    "@remotion/google-fonts": "4.0.516",
    "@remotion/mac-cursors": "4.0.516",
    "@remotion/player": "4.0.516",
    "@remotion/renderer": "4.0.516",
    "@tabler/icons-react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tiptap/extension-highlight": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "@uiw/react-codemirror": "^4.25.9",
    "ag-grid-community": "^35.1.0",
    "ag-grid-react": "^35.1.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "ffmpeg-static": "^5.3.0",
    "knex": "^3.1.0",
    "maplibre-gl": "^5.13.0",
    "match-sorter": "^8.2.0",
    "node-sql-parser": "^5.4.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-querybuilder": "^8.16.1",
    "recharts": "^3.8.1",
    "remotion": "4.0.516",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.0",
    "@lingui/babel-plugin-lingui-macro": "^6.2.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.15.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "postcss": "^8.5.3",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwindcss": "^3.4.14",
    "tsx": "4.21.0",
    "typescript": "catalog:"
  }
}
