#!/usr/bin/env bash
# Pre-push hook: runs prettier, eslint --fix, and stylelint --fix on files
# changed on this branch (vs the merge-base with origin/develop or
# origin/main). Activated repo-wide by `core.hooksPath = .githooks`, which is
# configured by the `prepare` script in package.json after `pnpm install`.
#
# If the fixers modify any files, the hook exits non-zero with a list of the
# modified paths so the changes can be reviewed and committed before pushing.

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 0

# i18n translation pipeline: keep the Lingui catalogs in sync with the source
# before pushing. The script no-ops fast when extract produces no catalog
# changes; otherwise it runs the LLM translation step and recompiles, and we
# exit 2 so the contributor can review and commit the regenerated files.
echo "pre-push hook: running i18n:update-translations..." >&2
if ! ./scripts/i18n/update-translations.sh all >&2; then
  echo "pre-push hook: i18n:update-translations failed." >&2
  exit 1
fi
if ! git diff --quiet -- src/i18n/locales 2>/dev/null; then
  echo "" >&2
  echo "pre-push hook: translation catalogs were updated. Review and commit before pushing:" >&2
  git diff --name-only -- src/i18n/locales >&2
  exit 2
fi

# Paths matching any of these extended regex patterns are skipped by the
# formatters/linters below. Add new patterns here to keep this list readable.
IGNORE_PATTERNS=(
  '^node_modules/'
  '^shared/types/database\.types\.ts$'
  '^supabase/migrations/.*\.sql$'
  '^src/i18n/locales/.*/messages\.ts$'
  '\.gen\.[^/]+$'
  '\.md$'
  '\.lock$'
  '(^|/)pnpm-lock\.yaml$'
)
IGNORE_REGEX=$(IFS='|'; echo "${IGNORE_PATTERNS[*]}")

BASE=""
for ref in origin/develop origin/main; do
  if git rev-parse --verify "$ref" >/dev/null 2>&1; then
    if BASE=$(git merge-base HEAD "$ref" 2>/dev/null) && [ -n "$BASE" ]; then
      break
    fi
    BASE=""
  fi
done

if [ -z "$BASE" ]; then
  echo "pre-push hook: could not resolve base branch; skipping." >&2
  exit 0
fi

CHANGED=()
while IFS= read -r line; do
  [ -n "$line" ] && CHANGED+=("$line")
done < <(
  git diff --name-only --diff-filter=ACMR "$BASE" HEAD \
    | grep -Ev "$IGNORE_REGEX" \
    || true
)

if [ ${#CHANGED[@]} -eq 0 ]; then
  exit 0
fi

EXISTING=()
for f in "${CHANGED[@]}"; do
  [ -f "$f" ] && EXISTING+=("$f")
done

if [ ${#EXISTING[@]} -eq 0 ]; then
  exit 0
fi

echo "pre-push hook: formatting ${#EXISTING[@]} changed file(s)..." >&2

pnpm exec prettier --write --ignore-unknown --log-level warn "${EXISTING[@]}" >&2 || true

JSTS=()
CSS=()
for f in "${EXISTING[@]}"; do
  case "$f" in
    *.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs) JSTS+=("$f") ;;
    *.css) CSS+=("$f") ;;
  esac
done

if [ ${#JSTS[@]} -gt 0 ]; then
  pnpm exec eslint --fix --no-warn-ignored "${JSTS[@]}" >&2 || true
fi

if [ ${#CSS[@]} -gt 0 ]; then
  pnpm exec stylelint --fix --allow-empty-input "${CSS[@]}" >&2 || true
fi

if ! git diff --quiet -- "${EXISTING[@]}" 2>/dev/null; then
  echo "" >&2
  echo "pre-push hook: formatters/linters modified the following files. Review and commit before creating the PR:" >&2
  git diff --name-only -- "${EXISTING[@]}" >&2
  exit 2
fi

exit 0
