#!/usr/bin/env bash
# Pre-push (pre-PR) hook. Two stages:
#   1. i18n translation pipeline: keep the Lingui catalogs in sync with the
#      source before pushing. The script no-ops fast when extract produces no
#      catalog changes; otherwise it runs the LLM translation step and
#      recompiles, and we exit 2 so the contributor can review and commit the
#      regenerated files.
#   2. Shared formatter: runs scripts/format-changed-files/format-changed-files.sh
#      on files changed on this branch (vs origin/develop or origin/main). All
#      formatting logic lives there so the same behavior is available manually
#      via `pnpm format`. If that script modifies any files it exits non-zero,
#      which blocks the push so the changes can be reviewed and committed first.
#
# Activated repo-wide by `core.hooksPath = .githooks`, configured by the
# `prepare` script in package.json after `pnpm install`.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
  exit 0
fi
cd "$REPO_ROOT" || exit 0

# Stage 0: fast no-op when there is nothing to push. Git feeds the refs being
# pushed on stdin as "<local-ref> <local-sha> <remote-ref> <remote-sha>" lines.
# If every local sha already matches its remote sha (or stdin is empty), there
# are no new commits to push, so skip the i18n and formatting stages entirely.
has_updates=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  if [ "$local_sha" != "$remote_sha" ]; then
    has_updates=1
  fi
done
if [ "$has_updates" -eq 0 ]; then
  exit 0
fi

# Stage 1: i18n catalogs.
echo "pre-push hook: running i18n:translations..." >&2
if ! ./scripts/i18n/update-translations.sh all >&2; then
  echo "pre-push hook: i18n:translations failed." >&2
  exit 1
fi
if ! git diff --quiet -- src/i18n/locales 2>/dev/null; then
  echo "" >&2
  echo "pre-push hook: translation catalogs were updated. Review and commit before pushing:" >&2
  git diff --name-only -- src/i18n/locales >&2
  exit 2
fi

# Stage 2: shared formatter (handles its own change-detection and exit codes).
exec "$REPO_ROOT/scripts/format-changed-files/format-changed-files.sh"
