#!/usr/bin/env bash
# Pre-push (pre-PR) hook: runs the shared formatter script on files changed
# on this branch (vs origin/develop or origin/main). Activated repo-wide by
# `core.hooksPath = .githooks`, configured by the `prepare` script in
# package.json after `pnpm install`.
#
# All formatting logic lives in scripts/format-changed-files/ so the same
# behavior is available manually via `pnpm format`. If that script modifies
# any files it exits non-zero, which blocks the push so the changes can be
# reviewed and committed first.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
  exit 0
fi

exec "$REPO_ROOT/scripts/format-changed-files/format-changed-files.sh"
