# Environment variables to run Supabase edge functions locally.
# Instructions:
# 1. Copy this file to your project root as `.env.development.edge`
# 2. Update the values with your secrets.
# 3. Run `pnpm fns:update-env` to move these env variables to the
#    `supabase/functions/.env` directory. You will need to do this every time
#    you update these env vars.

# ==============================================================================
# App environment
# ==============================================================================
# The Supabase secret key
SB_SECRET_KEY=

# The Supabase secret key
SB_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# JWT Issuer URL for JWT verification
SB_JWT_ISSUER=http://127.0.0.1:54321/auth/v1

# The environment type: "development", "staging" or "production"
MODE=development

# The absolute URL of the app
VITE_APP_URL=

# ==============================================================================
# Google environment variables
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ==============================================================================
# Billing/Polar
# ==============================================================================
POLAR_ACCESS_TOKEN=
POLAR_SERVER_TYPE="sandbox"

# ==============================================================================
# Upstash + Redis
# - To track rate limiting with Resend API
# ==============================================================================
UPSTASH_REDIS_API_URL=
UPSTASH_REDIS_REST_API_TOKEN=

# ==============================================================================
# Email
# ==============================================================================
RESEND_SENDING_API_KEY=
RESEND_FULL_ACCESS_API_KEY=

# This should be a NON-LOCALHOST domain, even for local development.
# In dev, the emails you send are still real emails (even when sent to
# `delivered@resend.dev`), so images will only load if they have a publicly
# accessible URL. This URL does not have to be the same as the VITE_APP_URL.
RESEND_SITE_IMG_URL=https://avandarlabs.com

# ==============================================================================
# Email local testing
# These variables should not get set in production.
# ==============================================================================

# Only change this if you absolutely *must* receive a transactional email on
# your real email while in development  Otherwise, stick to resend's
# `delivered@resend.dev` email.
DEV_EMAIL_OVERRIDE=delivered@resend.dev

# The id of the Resend segment for test broadcasts from the CLI
RESEND_LOCAL_TEST_SEGMENT_ID=

# ==============================================================================
# OpenAI
# ==============================================================================
OPENAI_API_KEY=
OPEN_ROUTER_API_KEY=

# ==============================================================================
# Featurebase (Customer support)
# ==============================================================================
FEATUREBASE_JWT_SECRET=secret

# ==============================================================================
# Pipeline server (builds ODC listings' Parquet copies)
# ==============================================================================
# Where the `open-data` function asks for copy builds, and the secret it
# sends. Leave the URL empty to turn copy builds off: requests for a copy then
# answer 503. Locally the function runs in Docker, so the pipeline server on
# your machine is `host.docker.internal`, and its secret matches the one in
# `.env.development`.
AVA_PIPELINE_SERVER_URL=http://host.docker.internal:4611
AVA_PIPELINE_SERVER_SECRET=
# The project URL the pipeline server uses to read and write this project.
# Only needed locally, where the function sees its own project as
# `http://kong:8000`. Set it to your stack's API URL (`ava supabase status`).
AVA_PIPELINE_SERVER_SUPABASE_URL=http://127.0.0.1:54321

# ==============================================================================
# Address search (map place tool)
# ==============================================================================
# Geoapify API key for the `geocode` function. Leave empty to turn address
# search off: the route then answers 503 and the place tool still accepts map
# clicks and typed coordinates.
GEOAPIFY_API_KEY=
