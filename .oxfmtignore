# oxfmt does NOT auto-discover this file. It reads `.gitignore` and
# `.prettierignore` from the cwd unless `--ignore-path` is given, and
# `.prettierignore` is inverted to `*` so that Prettier only ever sees the
# Supabase schema SQL. Left to its defaults, oxfmt would therefore format
# nothing, so every invocation must pass `--ignore-path .oxfmtignore`.
# `.gitignore` is always honoured on top of this file.

node_modules
dist
build
.agents/**
src/routeTree.gen.ts
LICENSE
shared/types/database.types.ts

# Lingui compiled catalogs: autogenerated, colocated with messages.po
src/i18n/locales/*/messages.ts

# Prettier owns SQL. oxfmt must never touch it.
*.sql

# Markdown and generated files, matching the `\.md$` and `\.gen\.` entries in
# `scripts/format-changed-files/ignore-patterns.txt`. Nothing has ever
# reformatted prose here, and a whole-tree run would rewrite every table in
# `docs/`. `*.gen.*` also covers `src/routeTree.gen.ts`, which stays listed
# above so the reason for excluding it is readable on its own.
*.md
*.gen.*

# Trees ESLint already excludes, kept in sync so the formatter and the linter
# agree on what is "our" code. Most are gitignored too, but not all:
# `agent-skills/` is vendored third-party skill content that we do not restyle,
# and two of its files (the `dif` web shell's `shell.js` / `boot.js`) are
# deliberate IIFE fragments that no parser can read standalone.
.claude
.claude/**
agent-skills/**
apps/desktop/build/**
apps/desktop/bundle/**
apps/desktop/.electrobun-cache/**
playwright-report/**
.temp/**
supabase/.temp/**
