{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "semi": true,
  "tabWidth": 2,
  "sortImports": {
    "internalPattern": ["@/", "$/"],
    "newlinesBetween": false,
    "groups": [
      "value-builtin",
      "value-external",
      "value-internal",
      ["value-parent", "value-sibling", "value-index"],
      "type-import",
      "unknown"
    ]
  },
  "sortTailwindcss": {
    "functions": ["clsx", "cn", "cx"]
  },
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["*.jsonc", "**/*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
