# Keys the video producer (apps/ava-video-producer) needs.
#
# Copy this file to .env.video-producer.local (gitignored) in the workspace
# root and fill it in. Every producer command, including `pnpm showcase`,
# copies it to apps/ava-video-producer/.env.local before it starts. Edit the
# root file, never the copy: the next command overwrites the copy.
#
# Only these two keys are read from the file. They are never exported to
# process.env or bundled into browser code. Keys set in the process
# environment (for example in CI) take precedence over the file.

# Remotion Automators license key pair. Use your own keys, issued by Remotion.
# The public key starts with rm_pub_. Paste the private key exactly as issued.
REMOTION_PUBLIC_KEY=
REMOTION_PRIVATE_KEY=
