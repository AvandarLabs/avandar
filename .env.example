# ==============================================================================
# Public environment variables.
# These get sent to the client's browser.
# ==============================================================================
VITE_APP_URL=http://localhost:5173/
VITE_SUPABASE_API_URL=

# TODO: rename this to VITE_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_ANON_KEY=
VITE_HIDE_DEV_TOOLS=false

# Flags to enable. Must be a comma-separated list.
# See `FeatureFlagConfig.tsx` for available flags.
# Example: VITE_FEATURE_FLAGS=disable-self-registration,enable-user-feedback
# GIS: enable-gis-isochrone shows the later-release Isochrone slot in the map tools.
VITE_FEATURE_FLAGS=
# Set to true in Playwright / Vitest to avoid loading WebLLM weights (see tests/e2e/setup/ensureE2eViteFeatureFlags.ts)
# VITE_OFFLINE_CHAT_MOCK=true

# Google Picker API
VITE_GOOGLE_PICKER_API_KEY=

# The Cloud project number, passed to the Picker's `setAppId`. It is what ties
# a pick to the app whose per-file `drive.file` grant Google records, so
# without it a picked file 404s on export. Same project as GOOGLE_CLIENT_ID:
# it is that value's numeric prefix. Not a secret.
VITE_GOOGLE_PICKER_APP_ID=323714789211

# ==============================================================================
# Local dev server.
# ==============================================================================

# The port `pnpm dev` serves the app on. `ava supabase switch` repoints this and
# VITE_APP_URL at a free port so several worktrees can run at the same time, and
# `ava supabase restore` puts both back.
AVA_VITE_DEV_PORT=5173

# ==============================================================================
# Scripts environment variables.
# These environment variables are only used for running admin scripts locally.
# ==============================================================================

# Supabase service role key used only in scripts to do admin operations
# This should be your local database's service role key
# TODO: rename this to SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Supabase URL used in local scripts. Should be the same as
# VITE_SUPABASE_API_URL.
SUPABASE_URL=

# The URL on which to serve localhost with a reverse proxy. This is useful to
# expose the local Supabase API port publicly so that external services can post
# webhooks during local development.
REVERSE_PROXY_URL=

# ==============================================================================
# Upstash + Redis
# To track rate limiting with Resend API
# ==============================================================================
UPSTASH_REDIS_API_URL=
UPSTASH_REDIS_REST_API_TOKEN=

# ==============================================================================
# Email
# Environment variables necessary to use the Resend API.
# ==============================================================================
RESEND_SENDING_API_KEY=
RESEND_FULL_ACCESS_API_KEY=

# This should be a NON-LOCALHOST domain, even for local development.
# In dev, the emails you send are still real emails (even when sent to
# `delivered@resend.dev`), so images will only load if they have a publicly
# accessible URL. This URL does not have to be the same as the VITE_APP_URL.
RESEND_SITE_IMG_URL=https://avandarlabs.com

# ==============================================================================
# Email local testing
# These variables are ignored in production. These variables contain overrides
# that are used only when running email-related code locally.
# ==============================================================================

# Only change this if you absolutely *must* receive a transactional email on
# your real email while in development  Otherwise, stick to resend's
# `delivered@resend.dev` email.
DEV_EMAIL_OVERRIDE=delivered@resend.dev

# The id of the Resend segment for test broadcasts from the CLI
RESEND_LOCAL_TEST_SEGMENT_ID=

# ==============================================================================
# Billing/Polar (for local scripts only)
# ==============================================================================
POLAR_ACCESS_TOKEN=
POLAR_SERVER_TYPE=sandbox

# ==============================================================================
# dev-fanout-server environment variables.
# These environment variables are only used for running admin scripts locally.
# ==============================================================================

# The URL of the dev-fanout-server. This is the stable public URL that 3rd party
# staging services should post webhooks to. The fanout server will forward
# the requests to the registered ngrok dev URLs. This env var should only be set
# to a localhost URL if you are doing local testing of the fanout server itself.
AVA_DEV_FANOUT_SERVER_URL=

# The secret used to authenticate admin requests to the dev-fanout-server
AVA_DEV_FANOUT_ADMIN_SERVER_SECRET=secret

# ==============================================================================
# pipeline-server environment variables.
# These environment variables are used for the pipeline server
# ==============================================================================

# The URL of the pipeline-server.
AVA_PIPELINE_SERVER_URL=http://127.0.0.1:4611

# The secret used to authenticate admin requests to the pipeline server
AVA_PIPELINE_SERVER_SECRET=secret

# ==============================================================================
# OpenAI
# ==============================================================================
OPENAI_API_KEY=
OPEN_ROUTER_API_KEY=

# ==============================================================================
# Third-party end-to-end tests.
# Only read by specs tagged `@third-party`, which no default run and no CI job
# includes. See docs/rules/e2e-testing.md; set these to run
# `pnpm test:e2e:third-party`.
# ==============================================================================

# Refresh token for the Google account the real-Drive Sheets spec signs in as.
# It can read only the files that account picked through the Picker, and nothing
# else in that Drive. See docs/google-sheets-e2e.md.
E2E_GOOGLE_REFRESH_TOKEN=

# Drive file id of the test sheet. Keep it in a shared drive, so the spec also
# covers the `supportsAllDrives` regression against the real API.
E2E_GOOGLE_SHEET_ID=
E2E_GOOGLE_SHEET_NAME=
E2E_GOOGLE_EMAIL=
