{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "languages", "rules"],
  "properties": {
    "version": {
      "const": 1
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "typescript",
          "javascript",
          "python",
          "rust",
          "go",
          "ruby",
          "java",
          "kotlin",
          "swift",
          "c",
          "cpp",
          "csharp",
          "sql",
          "css",
          "shell",
          "yaml",
          "jsonc",
          "json"
        ]
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "class",
          "title",
          "scope",
          "applicability",
          "repair",
          "phases",
          "owner",
          "boundary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(AF|GD|RP|JR)-[0-9]{2}[AB]?$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "class": {
            "enum": ["AF", "GD", "RP", "JR"]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "applicability": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "typescript",
                "javascript",
                "python",
                "rust",
                "go",
                "ruby",
                "java",
                "kotlin",
                "swift",
                "c",
                "cpp",
                "csharp",
                "sql",
                "css",
                "shell",
                "yaml",
                "jsonc",
                "json"
              ]
            }
          },
          "repair": {
            "enum": ["safe", "guided", "evidence", "judgment"]
          },
          "phases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [3, 4, 5, 6]
            }
          },
          "owner": {
            "enum": ["lint", "avandar-code-review"]
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "class": {
                  "const": "JR"
                }
              }
            },
            "then": {
              "properties": {
                "owner": {
                  "const": "avandar-code-review"
                },
                "repair": {
                  "const": "judgment"
                },
                "phases": {
                  "maxItems": 0,
                  "type": "array"
                }
              }
            },
            "else": {
              "properties": {
                "owner": {
                  "const": "lint"
                },
                "phases": {
                  "minItems": 1,
                  "type": "array"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "class": {
                  "const": "AF"
                }
              }
            },
            "then": {
              "properties": {
                "repair": {
                  "const": "safe"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "class": {
                  "const": "GD"
                }
              }
            },
            "then": {
              "properties": {
                "repair": {
                  "const": "guided"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "class": {
                  "const": "RP"
                }
              }
            },
            "then": {
              "properties": {
                "repair": {
                  "const": "evidence"
                }
              }
            }
          }
        ]
      }
    }
  }
}
