{
  "name": "@avandar/ui",
  "version": "0.1.1",
  "description": "Shared React UI components for Avandar apps, built on Mantine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvandarLabs/avandar.git",
    "directory": "packages/web/ui"
  },
  "homepage": "https://github.com/AvandarLabs/avandar/tree/main/packages/web/ui#readme",
  "bugs": {
    "url": "https://github.com/AvandarLabs/avandar/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./styles.css": "./dist/ui.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@avandar/browser-utils": "workspace:*",
    "@avandar/hooks": "workspace:*",
    "@avandar/utils": "workspace:*",
    "clsx": "^2.1.1",
    "ts-pattern": "catalog:",
    "type-fest": "catalog:"
  },
  "peerDependencies": {
    "@mantine/core": "^9.2.0",
    "@mantine/form": "^9.2.0",
    "@mantine/hooks": "^9.2.0",
    "@mantine/modals": "^9.2.0",
    "@mantine/notifications": "^9.2.0",
    "@tabler/icons-react": "^3.31.0",
    "@tanstack/react-router": "^1.170.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@mantine/core": "catalog:",
    "@mantine/form": "catalog:",
    "@mantine/hooks": "catalog:",
    "@mantine/modals": "catalog:",
    "@mantine/notifications": "catalog:",
    "@tabler/icons-react": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^7.0.4",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./hooks": {
        "types": "./dist/hooks.d.ts",
        "default": "./dist/hooks.js"
      },
      "./styles.css": "./dist/ui.css"
    }
  }
}
