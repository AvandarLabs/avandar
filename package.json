{
  "name": "avandar",
  "license": "CPAL-1.0",
  "private": true,
  "version": "0.9.3-dev",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "./scripts/startAvandar.sh",
    "dev:desktop": "./scripts/devDesktop.sh",
    "dev:email": "dotenv -e .env.development -- email dev --dir shared/emails",
    "dev:pipeline-server": "dotenv --no-expand -o -e .env.development -- pnpm --filter @avandar/pipeline-server dev",
    "dev:pipeline-server-prod": "dotenv --no-expand -o -e .env.development -e .env.production -- pnpm --filter @avandar/pipeline-server dev",
    "deploy:dev-fanout-server": "fly deploy --config apps/dev-fanout-server/fly.production.toml",
    "deploy:pipeline-server": "fly deploy --config apps/pipeline-server/fly.production.toml",
    "test": "./scripts/runAllTests.sh",
    "test:ava-cli": "pnpm --filter @avandar/ava-cli test",
    "test:ava-etl": "pnpm --filter @avandar/ava-etl test",
    "test:clients": "pnpm --filter @avandar/clients test",
    "test:desktop": "pnpm --filter @avandar/desktop test",
    "test:dev-fanout-server": "pnpm --filter @avandar/dev-fanout-server test",
    "test:pipeline-server": "pnpm --filter @avandar/pipeline-server test",
    "test:frontend": "vitest run --exclude \"apps/**\" --exclude \"packages/**\" --exclude \"shared/lib/**\"",
    "test:hooks": "pnpm --filter @avandar/hooks test",
    "test:logger": "pnpm --filter @avandar/logger test",
    "test:models": "pnpm --filter @avandar/models test",
    "test:modules": "pnpm --filter @avandar/modules test",
    "test:ui": "pnpm --filter @avandar/ui test",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:utils": "pnpm --filter @avandar/utils test",
    "build": "tsc -b && vite build",
    "build:ava-cli": "pnpm --filter @avandar/ava-cli build && ln -sf \"$(pwd)/apps/ava-cli/dist/main.cjs\" \"$(dirname $(which pnpm))/ava\"",
    "build:desktop": "pnpm build && pnpm --filter @avandar/desktop build",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "lint:ts:fix-changed": "git diff --name-only -z --diff-filter=ACMR HEAD | (grep -zE '\\.(js|jsx|ts|tsx|mjs|cjs)$' || true) | xargs -0 eslint --fix",
    "type-check": "tsc -b --noEmit",
    "type-check:desktop": "pnpm --filter @avandar/desktop type-check",
    "preview": "vite preview",
    "tsc-watch": "scripts/tsc-watch.sh",
    "db:apply-migrations": "./scripts/applyMigrations.sh",
    "desktop:sqlite:gen-migrations": "bun apps/desktop/scripts/gen-sqlite-migrations/main.ts",
    "desktop:sqlite:check-migrations": "bun apps/desktop/scripts/check-sqlite-migrations/main.ts",
    "db:create-user": "pnpm vite-script scripts/createUserScript.ts",
    "db:delete-user": "./scripts/db/delete-user/delete-user.sh",
    "db:gen-types": "supabase gen types typescript --local > shared/types/database.types.ts",
    "db:new-migration": "bash -c 'supabase stop && PGSSLMODE=disable supabase db diff -f \"$1\"' --",
    "db:down-migration": "./scripts/downMigration.sh",
    "db:redo-migration": "./scripts/redoLastMigration.sh --gen-types",
    "db:reset": "supabase start && dotenv -e .env.development -- ./scripts/resetDatabase.sh",
    "db:seed": "supabase start && dotenv -e .env.development -- pnpm vite-script scripts/seedDatabaseScript.ts",
    "db:sql": "PGPASSWORD=postgres psql -d postgres -U postgres -h 127.0.0.1 -p 54322",
    "db:sql-cmd": "PGPASSWORD=postgres psql -d postgres -U postgres -h 127.0.0.1 -p 54322 -c",
    "env:reset": "cp .env.example .env.development && cp .env.example.edge .env.development.edge",
    "email:send-email": "./scripts/emails/send-transactional-email/send-transactional-email.sh",
    "email:send-notification": "./scripts/emails/send-notification-email/send-notification-email.sh",
    "chat:regenerate-models": "pnpm vite-script scripts/regenerateChatModels.ts",
    "new:component": "./scripts/newComponent.sh",
    "new:route": "./scripts/generators/new-route/new-route.sh",
    "new:script": "./scripts/newScript.sh",
    "fns:call": "./scripts/edge-functions/callFunction.sh",
    "fns:update-env": "cp .env.development.edge supabase/functions/.env",
    "fns:serve": "supabase functions serve",
    "vite-script": "./scripts/utils/run-vite-script.sh",
    "util:get-current-version": "./scripts/utils/get-current-version.sh",
    "util:get-project-root": "./scripts/utils/get-project-root.sh",
    "i18n:extract": "lingui extract --overwrite",
    "i18n:extract-clean": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript",
    "i18n:check": "lingui extract --overwrite && git diff --exit-code src/i18n/locales",
    "i18n:translate-llm": "pnpm vite-script scripts/i18n/translateWithLLM.ts",
    "i18n:update": "pnpm i18n:extract && pnpm i18n:translate-llm && pnpm i18n:compile",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "preinstall": "npx only-allow pnpm",
