# Secrets only the data pipelines (apps/pipeline-server/pipelines) use.
#
# Copy this file to .env.pipelines.local (gitignored) and fill in what you
# have.
#
# It is loaded by both ways of running a pipeline:
#   - `ava pipeline run <name> --local`
#   - `pnpm dev:pipeline-server`
# A key that .env.development also defines keeps its .env.development value.

# Socrata app token, sent as the `X-App-Token` header to the Discovery API.
# Use an app token, not an API key ID/secret pair: the app token is what
# raises the rate limit for read-only requests. Create one in your Socrata
# profile under "Developer Settings".
SOCRATA_APP_TOKEN=
