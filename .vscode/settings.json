{
  "deno.enable": false,
  "deno.enablePaths": ["./supabase/functions", "./shared", "./packages/shared"],
  "deno.config": "./deno.json",
  "deno.lint": false,
  "deno.cacheOnSave": false,
  "deno.organizeImports.enabled": true,
  "deno.suggest.imports.autoDiscover": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "stylelint.configFile": "${workspaceFolder}/stylelint.config.js",
  "stylelint.validate": ["css", "tailwindcss"],
  "css.validate": false,
  "postcss.validate": false,
  "js/ts.tsdk.path": "./node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "cssVariables.lookupFiles": [
    "**/*.css",
    "**/*.scss",
    "**/*.sass",
    "**/*.less",
    "node_modules/@mantine/core/styles.css",
    "node_modules/mantine/styles/global.css"
  ]
}
