# Where `pnpm deploy:pipeline-server` deploys the pipeline server. Copy this
# file to `.env.pipeline-server.prod` (gitignored) and fill it in. Nothing in
# it is a secret on its own: deploying also needs Fly credentials with access
# to the app. The server's own secrets (Supabase keys, the server secret) are
# set on the app with `fly secrets set`, never here.

# The Fly app to deploy to, from `fly apps create <name>`.
FLY_APP_NAME=
# The Fly region the machine and its volume live in, such as `iad`. Pick one
# near the Supabase project.
FLY_PRIMARY_REGION=
# The machine size. A dedicated CPU keeps a long conversion from being
# throttled. See docs/measles-demo/pipeline-server-fly-runbook.md.
FLY_VM_SIZE=performance-1x
# The machine's memory, such as `2gb`.
FLY_VM_MEMORY=2gb
# The Fly volume mounted at /data, from `fly volumes create <name>`. Builds
# stream and convert sources there.
FLY_VOLUME_NAME=pipeline_server_data
# How much memory one DuckDB conversion may use before it spills to /data.
# Keep it at about half the machine's memory.
AVA_DUCKDB_MEMORY_LIMIT=1GB

# Optional. A deploy token scoped to the app (`fly tokens create deploy
# --app <name>`). Leave it empty to use your own `fly auth login`.
FLY_API_TOKEN=
